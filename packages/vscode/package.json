{
  "name": "llm-security-scan",
  "displayName": "LLMScan - AI Security Scanner",
  "description": "Bilingual (EN/JA) local static security scanner for Python, TypeScript, JavaScript, and PHP. Detects code/SQL injection and OWASP LLM05.",
  "version": "1.6.0",
  "publisher": "masahirocom",
  "icon": "icon.png",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/masahiroid/LLM-Security-Scanner.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "security",
    "owasp",
    "sql injection",
    "xss",
    "llm",
    "prompt injection"
  ],
  "main": "dist/extension.js",
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:php",
    "workspaceContains:.llmscan.yml",
    "onView:llmscan.findings"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "静的解析のみで、コードの実行や外部への送信は行いません。"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "llmscan",
          "title": "LLMScan",
          "icon": "media/llm.svg"
        }
      ]
    },
    "views": {
      "llmscan": [
        {
          "id": "llmscan.findings",
          "name": "%llmscan.views.findings%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "llmscan.findings",
        "contents": "%llmscan.viewsWelcome.clean%",
        "when": "llmscan.scanned"
      },
      {
        "view": "llmscan.findings",
        "contents": "%llmscan.viewsWelcome.idle%",
        "when": "!llmscan.scanned"
      }
    ],
    "commands": [
      {
        "command": "llmscan.scanWorkspace",
        "title": "%llmscan.commands.scanWorkspace%",
        "category": "LLMScan",
        "icon": "$(refresh)"
      },
      {
        "command": "llmscan.clearScan",
        "title": "%llmscan.commands.clearScan%",
        "category": "LLMScan",
        "icon": "$(clear-all)"
      },
      {
        "command": "llmscan.copyFindings",
        "title": "%llmscan.commands.copyFindings%",
        "category": "LLMScan",
        "icon": "$(copy)"
      },
      {
        "command": "llmscan.exportReport",
        "title": "%llmscan.commands.exportReport%",
        "category": "LLMScan",
        "icon": "$(output)"
      },
      {
        "command": "llmscan.toggleFilter",
        "title": "%llmscan.commands.toggleFilter%",
        "category": "LLMScan",
        "icon": "$(filter)"
      },
      {
        "command": "llmscan.createBaseline",
        "title": "%llmscan.commands.createBaseline%",
        "category": "LLMScan",
        "icon": "$(check-all)"
      },
      {
        "command": "llmscan.clearBaseline",
        "title": "%llmscan.commands.clearBaseline%",
        "category": "LLMScan",
        "icon": "$(discard)"
      },
      {
        "command": "llmscan.showDataflowGraph",
        "title": "%llmscan.commands.showDataflowGraph%",
        "category": "LLMScan",
        "icon": "$(type-hierarchy-sub)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "llmscan.scanWorkspace",
          "when": "view == llmscan.findings",
          "group": "navigation@1"
        },
        {
          "command": "llmscan.clearScan",
          "when": "view == llmscan.findings",
          "group": "navigation@2"
        },
        {
          "command": "llmscan.copyFindings",
          "when": "view == llmscan.findings",
          "group": "navigation@3"
        },
        {
          "command": "llmscan.exportReport",
          "when": "view == llmscan.findings",
          "group": "navigation@4"
        },
        {
          "command": "llmscan.toggleFilter",
          "when": "view == llmscan.findings",
          "group": "navigation@5"
        },
        {
          "command": "llmscan.createBaseline",
          "when": "view == llmscan.findings",
          "group": "1_baseline@1"
        },
        {
          "command": "llmscan.clearBaseline",
          "when": "view == llmscan.findings",
          "group": "1_baseline@2"
        }
      ],
      "view/item/context": [
        {
          "command": "llmscan.showDataflowGraph",
          "when": "view == llmscan.findings && viewItem == finding",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "LLMScan",
      "properties": {
        "llmscan.enable": {
          "type": "boolean",
          "default": true,
          "description": "%llmscan.config.enable%"
        },
        "llmscan.minConfidence": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high"
          ],
          "enumDescriptions": [
            "Follow .llmscan.yml configuration (default: medium)",
            "Show all findings including low-confidence heuristics",
            "Show findings where dataflow is plausibly traced",
            "Show only findings where dataflow path is confirmed"
          ],
          "default": "",
          "description": "%llmscan.config.minConfidence%"
        },
        "llmscan.showBaselined": {
          "type": "boolean",
          "default": false,
          "description": "%llmscan.config.showBaselined%"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && vsce package --no-dependencies",
    "publish": "npm run build && vsce publish --no-dependencies"
  },
  "dependencies": {
    "@llmscan/core": "1.6.0",
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-uri": "3.1.0"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2"
  }
}
