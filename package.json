{
  "name": "llm-security-scanner",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/vscode"
  ],
  "scripts": {
    "build": "npm run build -w @llmscan/cli -w llm-security-scan",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "node packages/cli/dist/cli.js scan",
    "package:extension": "npm run package -w llm-security-scan",
    "publish:extension": "npm run publish -w llm-security-scan"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
